<Window x:Class="Nook.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nook"
        Title="Nook · Configurações"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="290" SizeToContent="Height" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Hairline}" Background="#EE161616">
        <StackPanel Margin="16,12,16,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/nook.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Nook" Foreground="{StaticResource Fg}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24"
                        HorizontalAlignment="Right" ToolTip="{local:Tr Close}" Click="Close_Click"/>
            </Grid>

            <ToggleButton x:Name="SecElements" Tag="Elements" Style="{StaticResource SectionToggle}" Content="{local:Tr SecElements}"/>
            <UniformGrid Columns="2" x:Name="ButtonsGrid" Visibility="{Binding IsChecked, ElementName=SecElements, Converter={StaticResource BoolToVis}}">
                <CheckBox Style="{StaticResource Switch}" Content="{local:Tr Shuffle}" Tag="ShowShuffle" Margin="0,3,12,3"/>
                <CheckBox Style="{StaticResource Switch}" Content="{local:Tr Repeat}" Tag="ShowRepeat"/>
                <CheckBox Style="{StaticResource Switch}" Content="{local:Tr Progress}" Tag="ShowProgress" Margin="0,3,12,3"/>
                <CheckBox Style="{StaticResource Switch}" Content="{local:Tr OpenSpotify}" Tag="ShowOpen"/>
            </UniformGrid>

            <ToggleButton x:Name="SecLook" Tag="Look" Style="{StaticResource SectionToggle}" Content="{local:Tr SecLook}"/>
            <StackPanel Visibility="{Binding IsChecked, ElementName=SecLook, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{local:Tr Style}" Foreground="{StaticResource Fg}" FontSize="12" Margin="0,0,0,4"/>
            <Border Background="#14FFFFFF" CornerRadius="8" Margin="0,0,0,8">
                <UniformGrid x:Name="StyleGroup" Columns="3">
                    <RadioButton Style="{StaticResource Segment}" GroupName="Style" Tag="Minimalist" Content="{local:Tr Minimalist}"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="Style" Tag="OldSchool" Content="{local:Tr OldSchool}"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="Style" Tag="Refined" Content="{local:Tr Refined}"/>
                </UniformGrid>
            </Border>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{local:Tr Layout}" Foreground="{StaticResource Fg}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="8">
                    <UniformGrid x:Name="LayoutGroup" Columns="2">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Layout" Tag="H" Content="{local:Tr Horizontal}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Layout" Tag="V" Content="{local:Tr Vertical}"/>
                    </UniformGrid>
                </Border>
            </Grid>
            <Grid>
                <TextBlock Text="{local:Tr Size}" Foreground="{StaticResource Fg}" FontSize="12"/>
                <TextBlock x:Name="ScaleLabel" Foreground="{StaticResource FgDim}" FontSize="12" HorizontalAlignment="Right"/>
            </Grid>
            <Slider x:Name="ScaleSlider" Style="{StaticResource FlatSlider}" Minimum="0.7" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" Margin="0,2,0,6"/>

            <CheckBox Style="{StaticResource Switch}" Content="{local:Tr CoverAccent}" Tag="CoverAccent"/>
            </StackPanel>

            <ToggleButton x:Name="SecBehavior" Tag="Behavior" Style="{StaticResource SectionToggle}" Content="{local:Tr SecBehavior}"/>
            <StackPanel Visibility="{Binding IsChecked, ElementName=SecBehavior, Converter={StaticResource BoolToVis}}">
            <CheckBox Style="{StaticResource Switch}" Content="{local:Tr FocusTimer}" Tag="FocusTimer"/>
            <CheckBox Style="{StaticResource Switch}" Content="{local:Tr HideFullscreen}" Tag="HideOnFullscreen"/>
            <CheckBox Style="{StaticResource Switch}" Content="{local:Tr HideIdle}" Tag="HideWhenIdle"/>
            <CheckBox Style="{StaticResource Switch}" Content="{local:Tr Lock}" Tag="LockPosition"/>
            <CheckBox Style="{StaticResource Switch}" Content="{local:Tr TrayIcon}" Tag="TrayIcon"/>
            <CheckBox Style="{StaticResource Switch}" Content="{local:Tr Startup}" Tag="StartWithWindows"/>
            <TextBlock Text="{local:Tr AutoHide}" Foreground="{StaticResource Fg}" FontSize="12" Margin="0,10,0,4"/>
            <Border Background="#14FFFFFF" CornerRadius="8">
                <UniformGrid x:Name="AutoHideGroup" Columns="4">
                    <RadioButton Style="{StaticResource Segment}" GroupName="AutoHide" Tag="0" Content="{local:Tr Never}"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="AutoHide" Tag="1" Content="1 min"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="AutoHide" Tag="5" Content="5 min"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="AutoHide" Tag="15" Content="15 min"/>
                </UniformGrid>
            </Border>
            </StackPanel>

            <Grid Margin="0,14,0,0">
                <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="Spotify_Click"
                        Background="{StaticResource Accent}" Foreground="#111111">
                    <TextBlock Text="{local:Tr OpenSpotify}" FontWeight="SemiBold"/>
                </Button>
                <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" Click="Quit_Click" Content="{local:Tr QuitNook}"/>
            </Grid>
            <!-- Rodapé: redes e versão -->
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Hairline}" Margin="0,12,0,0" Padding="0,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="GitHubBtn" Style="{StaticResource IconButton}" Width="26" Height="26"
                                ToolTip="{local:Tr GitHubTip}" Click="GitHub_Click">
                            <Path Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource FgDim}"
                                  Data="M 8 0 C 3.58 0 0 3.58 0 8 c 0 3.54 2.29 6.53 5.47 7.59 .4 .07 .55 -.17 .55 -.38 0 -.19 -.01 -.82 -.01 -1.49 -2.01 .37 -2.53 -.49 -2.69 -.94 -.09 -.23 -.48 -.94 -.82 -1.13 -.28 -.15 -.68 -.52 -.01 -.53 .63 -.01 1.08 .58 1.23 .82 .72 1.21 1.87 .87 2.33 .66 .07 -.52 .28 -.87 .51 -1.07 -1.78 -.2 -3.64 -.89 -3.64 -3.95 0 -.87 .31 -1.59 .82 -2.15 -.08 -.2 -.36 -1.02 .08 -2.12 0 0 .67 -.21 2.2 .82 .64 -.18 1.32 -.27 2 -.27 .68 0 1.36 .09 2 .27 1.53 -1.04 2.2 -.82 2.2 -.82 .44 1.1 .16 1.92 .08 2.12 .51 .56 .82 1.27 .82 2.15 0 3.07 -1.87 3.75 -3.65 3.95 .29 .25 .54 .73 .54 1.48 0 1.07 -.01 1.93 -.01 2.2 0 .21 .15 .46 .55 .38 A 8.013 8.013 0 0 0 16 8 c 0 -4.42 -3.58 -8 -8 -8 z"/>
                        </Button>
                        <Button x:Name="InstagramBtn" Style="{StaticResource IconButton}" Width="26" Height="26"
                                ToolTip="{local:Tr InstagramTip}" Click="Instagram_Click">
                            <Grid Width="13" Height="13">
                                <Border BorderBrush="{StaticResource FgDim}" BorderThickness="1.4" CornerRadius="3.6"/>
                                <Ellipse Width="5.6" Height="5.6" Stroke="{StaticResource FgDim}" StrokeThickness="1.4"/>
                                <Ellipse Width="1.8" Height="1.8" Fill="{StaticResource FgDim}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2.2,2.2,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource FgDim}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
