<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Nook</AssemblyName>
    <RootNamespace>Nook</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\nook.ico</ApplicationIcon>
    <Product>Nook</Product>
    <AssemblyTitle>Nook — mini player</AssemblyTitle>

    <!-- Leveza: sem thread de GC em segundo plano e GC economizando memória -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\nook.ico" />
    <Resource Include="Assets\nook.png" />
  </ItemGroup>

</Project>
